# ==============================================================================
# FINBUD ENVIRONMENT CONFIGURATION (Backend)
# ==============================================================================

# Application settings
PROJECT_NAME="FINBUD Financial Intelligence"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"

# CORS configuration (Frontend origins)
# Supports comma-separated origins or JSON array.
# Do NOT use wildcard '*' when credentials are true.
# Example: "https://finbud.vercel.app,http://localhost:3000"
CORS_ORIGINS="https://finbud.vercel.app,http://localhost:3000"

# Supabase Credentials (Obtain from your Supabase Dashboard: Project Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key-here"
# Backend-ONLY elevated privileges key. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_JWT_SECRET="your-jwt-secret-here"

# RAG & LLM Integration (Google Gemini API)
# Obtain a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Market Data Caching (Seconds)
MARKET_CACHE_TTL_SECONDS=3600
