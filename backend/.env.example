# ==============================================================================
# FINBUD ENVIRONMENT CONFIGURATION (Backend)
# ==============================================================================

# Application settings
PROJECT_NAME="FINBUD Financial Intelligence"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
PORT=8000
HOST="127.0.0.1"

# CORS configuration (Frontend origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Supabase Credentials (Obtain from your Supabase Dashboard: Project Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_JWT_SECRET="your-jwt-secret-here"

# RAG & LLM Integration (Google Gemini API / Groq)
# You can obtain a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional Market Data API keys (Yahoo Finance is free/open; GoldAPI optional)
MARKET_CACHE_TTL_SECONDS=3600

